{
  "name": "campus-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24.22.0 <25",
    "pnpm": "10.33.4"
  },
  "scripts": {
    "check:structure": "node tools/check-structure.mjs",
    "contracts:generate": "pnpm --filter @campus/contracts generate",
    "build": "pnpm contracts:generate && pnpm -r --sort build",
    "typecheck": "pnpm contracts:generate && pnpm --filter @campus/contracts build && pnpm -r --sort typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test packages/contracts/test/*.test.ts",
    "check": "pnpm check:structure && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:scaffold",
    "dev": "pnpm contracts:generate && pnpm --filter @campus/contracts build && node tools/dev-local.mjs",
    "db:generate": "pnpm --filter @campus/resource-core db:generate && pnpm --filter @campus/workflow db:generate",
    "db:migrate": "pnpm --filter @campus/resource-core db:migrate && pnpm --filter @campus/workflow db:migrate",
    "db:seed": "pnpm --filter @campus/resource-core db:seed && pnpm --filter @campus/workflow db:seed",
    "db:config": "docker compose --env-file infra/local/.env -f infra/local/compose.yaml config --quiet",
    "db:up": "docker compose --env-file infra/local/.env -f infra/local/compose.yaml up -d --wait",
    "db:down": "docker compose --env-file infra/local/.env -f infra/local/compose.yaml down",
    "test:scaffold": "node tools/smoke-scaffold.mjs",
    "db:verify": "node tools/verify-local-db.mjs",
    "test:database": "pnpm db:verify && node tools/smoke-scaffold.mjs --with-local-db",
    "db:seed:demo": "pnpm --filter @campus/resource-core db:seed:demo",
    "test:identity": "node tools/test-identity.mjs",
    "test:identity:data": "node tools/verify-identity-data.mjs",
    "test:scheduling": "node tools/test-scheduling.mjs",
    "test:workflow": "node tools/test-workflow.mjs",
    "test:workflow:data": "node tools/verify-workflow-data.mjs",
    "test:workorders": "node tools/test-workorders.mjs",
    "test:workorders:data": "node tools/verify-workorders-data.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "24.10.1",
    "prettier": "3.9.10",
    "eslint": "10.12.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.71.2",
    "eslint-plugin-vue": "10.11.1",
    "vue-eslint-parser": "10.4.1",
    "globals": "17.13.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "eslint-config-prettier": "10.1.8"
  }
}
