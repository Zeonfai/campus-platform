{
  "name": "@campus/workflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm db:generate && nest build",
    "dev": "pnpm db:generate && nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "pnpm db:generate && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:migrate": "prisma migrate deploy --config prisma.config.ts",
    "db:seed": "prisma db seed --config prisma.config.ts"
  },
  "dependencies": {
    "@campus/contracts": "workspace:*",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/swagger": "12.0.2",
    "@prisma/client": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "pg": "8.23.1",
    "dotenv": "18.0.8",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "class-validator": "0.15.1",
    "class-transformer": "0.5.1",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "helmet": "8.3.0"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
